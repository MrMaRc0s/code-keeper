---
services:
  runner:
    image: "{{ gitlab_runner_image }}"
    container_name: "{{ gitlab_runner_container_name }}"
    restart: unless-stopped
    network_mode: host
    security_opt:
      - label=disable
    volumes:
      - "{{ gitlab_runner_base_directory }}/config:/etc/gitlab-runner:Z"
      - "/var/run/docker.sock:/var/run/docker.sock"
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "3"
