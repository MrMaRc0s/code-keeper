---
all:
  children:
    gitlab_servers:
      hosts:
        gitlab:
          ansible_host: "<tailscale-ip-or-dns>"
          ansible_user: "<remote-user>"
          ansible_ssh_private_key_file: "<absolute-path-to-private-key>"
    gitlab_runners:
      hosts:
        runner:
          ansible_host: "<tailscale-ip-or-dns>"
          ansible_user: "<remote-user>"
          ansible_ssh_private_key_file: "<absolute-path-to-private-key>"

